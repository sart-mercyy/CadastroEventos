<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.ResumoEventoPage"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="{Binding Nome}" FontSize="24" FontAttributes="Bold" />

            <VerticalStackLayout Spacing="2">
                <Label Text="Local" FontAttributes="Bold" />
                <Label Text="{Binding Local}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Data de início" FontAttributes="Bold" />
                <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Data de término" FontAttributes="Bold" />
                <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Duração" FontAttributes="Bold" />
                <Label Text="{Binding DuracaoTexto}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Número de participantes" FontAttributes="Bold" />
                <Label Text="{Binding NumeroParticipantes}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Custo por participante" FontAttributes="Bold" />
                <Label Text="{Binding CustoPorParticipanteFormatado}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Custo total do evento" FontAttributes="Bold" />
                <Label Text="{Binding CustoTotalFormatado}" FontSize="22" FontAttributes="Bold" />
            </VerticalStackLayout>

            <Button Text="Novo cadastro" Clicked="OnVoltarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
